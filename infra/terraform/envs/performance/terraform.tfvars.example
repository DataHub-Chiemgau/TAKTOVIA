# Beispielparameter fuer performance. Keine Zugangsdaten. Anbieter/Region stehen unter D-05 (offen).
hosting_provider          = "unset"
hosting_region            = "unset"
secret_domain             = "taktovia-performance-secrets"
identity_domain           = "taktovia-performance-idp"
psp_domain                = "taktovia-performance-psp"
db_migration_access       = "taktovia-performance-migrator"
db_runtime_access         = "taktovia-performance-runtime"
account_domain            = "taktovia-performance-account"
network_domain            = "taktovia-performance-net"
db_ingress_network_domain = "taktovia-performance-net"
