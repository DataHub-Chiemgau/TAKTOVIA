# Beispielparameter fuer staging. Keine Zugangsdaten. Anbieter/Region stehen unter D-05 (offen).
hosting_provider          = "unset"
hosting_region            = "unset"
secret_domain             = "taktovia-staging-secrets"
identity_domain           = "taktovia-staging-idp"
psp_domain                = "taktovia-staging-psp"
db_migration_access       = "taktovia-staging-migrator"
db_runtime_access         = "taktovia-staging-runtime"
account_domain            = "taktovia-staging-account"
network_domain            = "taktovia-staging-net"
db_ingress_network_domain = "taktovia-staging-net"
