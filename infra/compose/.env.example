# NUR LOKAL / Entwicklung. Kopieren nach .env (wird nicht eingecheckt). Keine echten Geheimnisse.
# Alle Imageversionen: "nicht gegen Registry geprüft" (siehe infra/README.md, Abschnitt Versionen).
COMPOSE_PROJECT_NAME=taktovia-dev

# --- Images (Tags nicht gegen Registry geprüft; Digest-Pinning offen, siehe README) ---
POSTGRES_IMAGE=postgis/postgis:17-3.5
RABBITMQ_IMAGE=rabbitmq:4-management
REDIS_IMAGE=valkey/valkey:8
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
MINIO_IMAGE=minio/minio:latest
VALHALLA_IMAGE=ghcr.io/gis-ops/docker-valhalla/valhalla:latest
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.100.0
PROMETHEUS_IMAGE=prom/prometheus:v2.53.0

# --- Ports (Konvention: Host-Ports nur auf 127.0.0.1, Basis 1xxxx) ---
PG_PORT=15432
RABBIT_AMQP_PORT=15672
RABBIT_UI_PORT=25672
REDIS_PORT=16379
KEYCLOAK_PORT=18080
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
VALHALLA_PORT=18002
OTLP_GRPC_PORT=14317
OTLP_HTTP_PORT=14318
OTEL_HEALTH_PORT=13133
PROMETHEUS_PORT=19090

# --- Entwicklungswerte, NUR LOKAL ---
POSTGRES_USER=dev_admin
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=taktovia
RABBITMQ_DEFAULT_USER=taktovia
RABBITMQ_DEFAULT_PASS=dev-only-change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-only-change-me
MINIO_ROOT_USER=taktovia-dev
MINIO_ROOT_PASSWORD=dev-only-change-me
# Valhalla: URL eines kleinen OSM-Ausschnitts (.osm.pbf), siehe README; leer = kein Download
VALHALLA_TILE_URLS=
