# TLS-Terminierung am Gateway für API, Web- und Admin-Oberfläche (WP-M1-36, LH-6.18-SEC-002).
# STATUS: statisch geprüft (infra/check.py), NICHT gestartet (kein nginx/Docker in der Entwicklungsumgebung).
# Zertifikat und Schlüssel werden aus der Secret-Verwaltung der Umgebung eingehängt (Pfad per Umgebungsvariable), nie im Image.
# Planungsdefault OP-31: TLS 1.2 und 1.3; Cipher-Vorgabe: nur AEAD-Suiten mit Forward Secrecy für 1.2.

# Klartext-Port: keine Nutzdaten, Verbindung wird ohne Antwort geschlossen (444); kein Redirect, damit kein Klartext-Request bedient wird.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name ${TAKTOVIA_PUBLIC_HOST};

    ssl_certificate     ${TAKTOVIA_TLS_CERT_FILE};
    ssl_certificate_key ${TAKTOVIA_TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /v1/ { proxy_pass https://backend; proxy_set_header X-Forwarded-Proto https; }
    location /admin/ { proxy_pass https://web_admin; proxy_set_header X-Forwarded-Proto https; }
    location / { proxy_pass https://web; proxy_set_header X-Forwarded-Proto https; }
}
