{
 "uid": "taktovia-infrastruktur",
 "title": "Infrastruktur (RabbitMQ, Redis, PostgreSQL)",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "tags": [
  "taktovia",
  "betrieb"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "tenant_id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(taktovia_outbox_depth, tenant_id)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "RabbitMQ: bereite Nachrichten je Queue",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rabbitmq_queue_messages_ready",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "RabbitMQ: nicht bestätigte Nachrichten",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rabbitmq_queue_messages_unacked",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Redis: Speicher und Clients",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_memory_used_bytes",
     "legendFormat": "Speicher"
    },
    {
     "refId": "B",
     "expr": "redis_connected_clients",
     "legendFormat": "Clients"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "PostgreSQL: Verbindungen und Transaktionen",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pg_stat_activity_count)",
     "legendFormat": "Verbindungen"
    },
    {
     "refId": "B",
     "expr": "rate(pg_stat_database_xact_commit[5m])",
     "legendFormat": "Commits/s"
    }
   ]
  }
 ]
}