{
 "uid": "taktovia-worker",
 "title": "Worker",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "tags": [
  "taktovia",
  "betrieb"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "tenant_id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(taktovia_outbox_depth, tenant_id)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Routing: Aufrufdauer p95 je Klasse",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route_class) (rate(taktovia_routing_request_seconds_bucket[5m])))",
     "legendFormat": "{{route_class}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Routing: Solverlaufzeit p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(taktovia_routing_solver_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Routing: Timeouts",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(taktovia_routing_timeouts_total[5m]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Routing: Queue-Wartezeit p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(taktovia_routing_queue_wait_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Dokumente: Aufgaben je Ergebnis",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind, result) (rate(taktovia_documents_tasks_total[5m]))",
     "legendFormat": "{{kind}} {{result}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Dokumente: Aufgabendauer p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(taktovia_documents_task_seconds_bucket[5m])))",
     "legendFormat": "{{kind}}"
    }
   ]
  }
 ]
}