{
  "realm": "taktovia-dev",
  "displayName": "TAKTOVIA Entwicklung (nur lokal, synthetische Daten)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "hashAlgorithm(argon2) and length(12) and notUsername and notEmail and passwordHistory(5) and forceExpiredPasswordChange(365)",
  "browserFlow": "taktovia-browser",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "webAuthnPolicyPasswordlessRpEntityName": "TAKTOVIA",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "not specified",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": false,
  "attributes": {
    "taktovia.environment": "development",
    "taktovia.note": "NUR LOKAL: Entwicklungs-Passwort, synthetische Testidentitaet",
    "taktovia.mfa.privileged_roles": "dispatcher,finance,tenant_admin",
    "taktovia.mfa.enforcement": "Backend: acr=loa2 fuer privilegierte Rollen (403 sonst); IdP: Step-up-Flow, operator-web fordert loa2 an",
    "taktovia.password.hash": "{\"algorithm\": \"argon2id\", \"memory_kib\": \"19456\", \"iterations\": \"2\", \"parallelism\": \"1\", \"hash_length_bytes\": \"32\"}",
    "acr.loa.map": "{\"loa1\": 1, \"loa2\": 2}"
  },
  "authenticationFlows": [
    {
      "alias": "taktovia-browser",
      "description": "TAKTOVIA Browser-Anmeldung: Passwort oder Passkey, zweiter Faktor bei Stufe loa2",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "taktovia-forms"
        }
      ]
    },
    {
      "alias": "taktovia-forms",
      "description": "Formularteil",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "taktovia-level1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "taktovia-level2"
        }
      ]
    },
    {
      "alias": "taktovia-level1",
      "description": "Stufe 1 (loa1): erster Faktor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "taktovia-loa1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-username-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "taktovia-first-factor"
        }
      ]
    },
    {
      "alias": "taktovia-first-factor",
      "description": "Erster Faktor: Passwort oder passwortlos (WebAuthn/Passkey)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-password-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "taktovia-level2",
      "description": "Stufe 2 (loa2): zweiter Faktor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "taktovia-loa2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "taktovia-second-factor"
        }
      ]
    },
    {
      "alias": "taktovia-second-factor",
      "description": "Zweiter Faktor: TOTP oder WebAuthn (Sicherheitsschluessel)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "taktovia-loa1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
