{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/cancellation_reasons.v1.schema.json",
  "title": "cancellation_reasons",
  "description": "Zulässige Stornogründe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reasons"
  ],
  "properties": {
    "reasons": {
      "type": "array",
      "minItems": 1,
