          "OPERATOR_CANCELLATION",
          "NO_SHOW",
          "PAYMENT_FAILED",
          "SAFETY",
          "VEHICLE_OUTAGE"
        ]
      }
    }
  },
  "default": {
    "reasons": [
      "PASSENGER_REQUEST",
      "OPERATOR_CANCELLATION",
      "NO_SHOW",
      "PAYMENT_FAILED",
      "SAFETY",
      "VEHICLE_OUTAGE"
    ]
  },
  "x-unit": "REASON_SET",
  "x-levels": [
    "TENANT",
    "REGION",
    "SERVICE"
  ],
  "x-security-class": "STANDARD",
  "x-limit-source": "PLANUNGSANNAHME",
  "x-catalog": "nicht im Katalog (WP-M2-26, OP-23)",
  "x-catalog-range": "Teilmenge des Grundkatalogs (booking_status_reason, Art CANCELLATION); Standard alle Gründe; Produktionswerte nach D-05"
}
