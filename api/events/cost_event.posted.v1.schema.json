{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/cost_event.posted.v1.schema.json",
  "title": "Kostenereignis gebucht (WP-M4-33, WP-M4-40)",
  "description": "Payload von `cost_event.posted`. Aggregat: economic_event (Revision 1). Entsteht in derselben Transaktion wie Ereignis und gebuchtes Journal (Outbox). Enthält Kennungen und Beträge in kleinster Einheit, keine Konten, Namen oder Belegfelder. Ein manuelles Fahrzeugkostenereignis (WP-M4-40, `event_type` `MANUAL_COST`) hat keinen Beleg: `document_id` entfällt, `manual_cost_event_id` nennt den freigegebenen Vorgang.",
  "type": "object",
  "required": [
    "event_id",
    "legal_entity_id",
    "event_type",
    "category",
    "currency",
    "gross_minor",
    "cost_basis_minor",
    "booked_at"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "legal_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "EXPENSE_COST",
        "MANUAL_COST"
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "gross_minor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cost_basis_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "booked_at": {
      "type": "string",
      "format": "date-time"
    },
    "manual_cost_event_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "examples": [
    {
      "event_id": "11111111-2222-4333-8444-555555555555",
      "document_id": "66666666-7777-4888-8999-000000000000",
      "legal_entity_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
      "event_type": "EXPENSE_COST",
      "category": "FUEL",
      "currency": "EUR",
      "gross_minor": 11900,
      "cost_basis_minor": 10000,
      "booked_at": "2026-12-01T06:10:00Z"
    }
  ]
}
