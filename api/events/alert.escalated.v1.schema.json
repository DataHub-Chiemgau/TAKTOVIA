{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/alert.escalated.v1.schema.json",
  "title": "Betriebsalarm eskaliert (WP-M3-52)",
  "description": "Payload von `alert.escalated`. Aggregat: business_alert. Nur Kennungen und Codes (Minimierungsregel, Kap. 05 §5.1). Katalog: docs/umsetzungsplan/vertraege/m3-ereigniskatalog.md.",
  "type": "object",
  "required": [
    "alert_id",
    "priority",
    "service_id",
    "escalation_level",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "NORMAL"
      ]
    },
    "service_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "escalation_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "state": {
      "enum": [
        "OPEN"
      ]
    }
  },
  "examples": [
    {
      "alert_id": "11111111-2222-4333-8444-555555555555",
      "priority": "HIGH",
      "service_id": null,
      "escalation_level": 1,
      "state": "OPEN"
    }
  ]
}
