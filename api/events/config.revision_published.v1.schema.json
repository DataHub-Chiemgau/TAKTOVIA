{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/config.revision_published.v1.schema.json",
  "title": "Konfigurationsrevision publiziert (WP-M1-22, LH-I.7-CFG-006)",
  "description": "Genau dann, wenn eine freigegebene Revision publiziert wurde (Wirksamkeit ab `effective_from`). Payload des Outbox-Ereignisses (Hülle: platform.eventenvelope.v1). `aggregate_id` der Hülle ist `revision_id`, `aggregate_revision` die Zeilenversion der publizierten Zeile; je (Aggregat, Revision, Ereignistyp) entsteht höchstens ein Ereignis. `predecessor_id` nennt die Vorgängerrevision, deren Intervall geschlossen wurde (sonst null); `rolled_back_from` ist gesetzt, wenn die Revision eine Rücknahme ist. Das Ereignis bleibt im Mandanten; die Werte der Konfiguration stehen nicht im Ereignis. Ereignisname und Felder sind Vorschlag (OP-33).",
  "type": "object",
  "required": [
    "revision_id",
    "scope_kind",
    "scope_id",
    "revision",
    "state",
    "schema_version",
    "effective_from",
    "effective_to",
    "audit_event_id",
    "predecessor_id",
    "rolled_back_from"
  ],
  "additionalProperties": false,
  "properties": {
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope_kind": {
      "type": "string",
      "enum": [
        "TENANT",
        "REGION",
        "DEPOT",
        "SERVICE"
      ]
    },
    "scope_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "const": "PUBLISHED"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}$"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "predecessor_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "rolled_back_from": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
