{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/booking.cancelled.v1.schema.json",
  "title": "Buchung storniert mit Grund und Verursacherklasse (WP-M2-26/-27)",
  "description": "Payload von `booking.cancelled`. Aggregat: booking. Keine exakten Adressen oder Kontaktdaten im Payload (Kap. 05 §5.1 Minimierung). Katalog: docs/umsetzungsplan/vertraege/m2-ereigniskatalog.md.",
  "type": "object",
  "required": [
    "booking_id",
    "reason",
    "reason_code",
    "cause_class",
    "initiator"
  ],
  "additionalProperties": false,
  "properties": {
    "booking_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "enum": [
        "PASSENGER_REQUEST",
        "OPERATOR_CANCELLATION",
        "NO_SHOW",
        "PAYMENT_FAILED",
        "SAFETY",
        "VEHICLE_OUTAGE"
      ]
    },
    "initiator": {
      "enum": [
        "PASSENGER",
        "OPERATOR",
        "SYSTEM"
      ]
    },
    "released_hold_id": {
      "type": "string",
      "format": "uuid"
    },
    "refund_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "reason_code": {
      "enum": [
        "PASSENGER_REQUEST",
        "OPERATOR_CANCELLATION",
        "NO_SHOW",
        "PAYMENT_FAILED",
        "SAFETY",
        "VEHICLE_OUTAGE"
      ],
      "description": "Typisierter Stornogrund (WP-M2-27), gleich `reason`."
    },
    "cause_class": {
      "enum": [
        "FAHRGAST",
        "BETREIBER",
        "FAHRZEUGAUSFALL"
      ],
      "description": "Verursacherklasse (WP-M2-27): Datenbasis der Kennzahlen Buchungsstornoquote Fahrgast/Betreiber (Fahrzeugausfall getrennt)."
    }
  },
  "examples": [
    {
      "booking_id": "5f1d4a0e-1b0a-4c3b-8e0f-2a3b4c5d6e7f",
      "reason": "VEHICLE_OUTAGE",
      "reason_code": "VEHICLE_OUTAGE",
      "cause_class": "FAHRZEUGAUSFALL",
      "initiator": "OPERATOR",
      "released_hold_id": "9a8b7c6d-1111-4222-8333-444455556666"
    }
  ]
}
