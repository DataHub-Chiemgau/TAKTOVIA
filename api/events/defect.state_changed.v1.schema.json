{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/defect.state_changed.v1.schema.json",
  "title": "Schadenakte: Status gewechselt (WP-M3-47)",
  "description": "Payload von `defect.state_changed`. Aggregat: defect_case / n. Nur Kennungen, Codes und Zähler: keine Begründungs- oder Beschreibungstexte, Namen oder Kontaktdaten (Minimierungsregel, Kap. 05 §5.1). Katalog: docs/umsetzungsplan/vertraege/m3-ereigniskatalog.md.",
  "type": "object",
  "required": [
    "defect_id",
    "case_number",
    "vehicle_id",
    "from_status",
    "to_status",
    "revision",
    "reopened"
  ],
  "additionalProperties": false,
  "properties": {
    "defect_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_number": {
      "type": "string",
      "maxLength": 32
    },
    "vehicle_id": {
      "type": "string",
      "format": "uuid"
    },
    "from_status": {
      "enum": [
        "NEW",
        "REVIEWED",
        "IN_PROGRESS",
        "REPAIR",
        "CLOSED",
        "DISMISSED"
      ]
    },
    "to_status": {
      "enum": [
        "NEW",
        "REVIEWED",
        "IN_PROGRESS",
        "REPAIR",
        "CLOSED",
        "DISMISSED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 2
    },
    "reopened": {
      "type": "boolean",
      "description": "dokumentierte Wiedereröffnung eines Endzustands"
    }
  },
  "examples": [
    {
      "defect_id": "11111111-2222-4333-8444-555555555555",
      "case_number": "SCH-2026-000123",
      "vehicle_id": "66666666-7777-4888-8999-aaaaaaaaaaaa",
      "from_status": "NEW",
      "to_status": "REVIEWED",
      "revision": 2,
      "reopened": false
    }
  ]
}
