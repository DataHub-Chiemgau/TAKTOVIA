{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/geo.stop_revision_effective.v1.schema.json",
  "title": "Haltepunktrevision wirksam (WP-M2-05)",
  "description": "Payload von `geo.stop_revision_effective`. Aggregat: Haltepunkt (`stop_id`, Revision = Revision der Kette); die Revision ist aktiv. Wirksam ab `valid_from` (links geschlossen, rechts offen). Keine Koordinaten oder Namen im Payload.",
  "type": "object",
  "required": ["stop_id", "revision_id", "revision", "active", "traffic_products", "valid_from", "valid_to"],
  "additionalProperties": false,
  "properties": {
    "stop_id": {"type": "string", "format": "uuid"},
    "revision_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "active": {"const": true},
    "traffic_products": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,39}$"}},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  }
}
