{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/defect.reported.v1.schema.json",
  "title": "Schaden gemeldet (WP-M3-43)",
  "description": "Payload von `defect.reported`. Aggregat: defect_case / 1. Nur Kennungen und Codes: keine Diagnosen, Beschreibungstexte, Fotos, Namen oder Kontaktdaten (Minimierungsregel, Kap. 05 §5.1). Katalog: docs/umsetzungsplan/vertraege/m3-ereigniskatalog.md.",
  "type": "object",
  "required": [
    "defect_id",
    "case_number",
    "vehicle_id",
    "category_code",
    "reporter_role"
  ],
  "additionalProperties": false,
  "properties": {
    "defect_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_number": {
      "type": "string",
      "maxLength": 32
    },
    "vehicle_id": {
      "type": "string",
      "format": "uuid"
    },
    "category_code": {
      "type": "string",
      "maxLength": 64
    },
    "reporter_role": {
      "enum": [
        "driver",
        "dispatcher",
        "workshop"
      ]
    }
  },
  "examples": [
    {
      "defect_id": "11111111-2222-4333-8444-555555555555",
      "case_number": "SCH-2026-000123",
      "vehicle_id": "66666666-7777-4888-8999-aaaaaaaaaaaa",
      "category_code": "BRAKES",
      "reporter_role": "driver"
    }
  ]
}
