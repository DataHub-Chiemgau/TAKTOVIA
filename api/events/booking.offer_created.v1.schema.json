{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/booking.offer_created.v1.schema.json",
  "title": "Angebot erstellt (WP-M2-21)",
  "description": "Payload von `booking.offer_created`. Aggregat: Angebot (ride_offer). Ein Angebot ohne Hold verspricht keine Kapazität. Keine exakten Adressen oder Kontaktdaten im Payload (Kap. 05 §5.1 Minimierung). Katalog: docs/umsetzungsplan/vertraege/m2-ereigniskatalog.md.",
  "type": "object",
  "required": [
    "offer_id",
    "attempt_id",
    "service_id",
    "expires_at",
    "pickup_earliest",
    "pickup_latest",
    "gross_minor",
    "currency"
  ],
  "additionalProperties": false,
  "properties": {
    "offer_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "pickup_earliest": {
      "type": "string",
      "format": "date-time"
    },
    "pickup_latest": {
      "type": "string",
      "format": "date-time"
    },
    "arrival_latest": {
      "type": "string",
      "format": "date-time"
    },
    "gross_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "examples": [
    {
      "offer_id": "5f1d4a0e-1b0a-4c3b-8e0f-2a3b4c5d6e7f",
      "attempt_id": "9a8b7c6d-1111-4222-8333-444455556666",
      "service_id": "0f6f6d0a-3c7b-4d9e-8f10-1c2d3e4f5a6b",
      "run_revision": 4,
      "expires_at": "2026-11-01T10:03:00Z",
      "pickup_earliest": "2026-11-01T11:00:00Z",
      "pickup_latest": "2026-11-01T11:15:00Z",
      "gross_minor": 950,
      "currency": "EUR"
    }
  ]
}
