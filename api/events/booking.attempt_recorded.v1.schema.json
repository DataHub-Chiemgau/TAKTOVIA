{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.example/schemas/booking.attempt_recorded.v1.schema.json",
  "title": "Anfrageversuch erfasst, abgelehnt oder technisch gescheitert (WP-M2-11/-13)",
  "description": "Payload von `booking.attempt_recorded`. Aggregat: travel_attempt. Empfänger: eigener Mandant (Analytics M4). Keine exakten Adressen oder Kontaktdaten im Payload (Kap. 05 §5.1 Minimierung). Katalog: docs/umsetzungsplan/vertraege/m2-ereigniskatalog.md.",
  "type": "object",
  "required": [
    "attempt_id",
    "service_id",
    "outcome",
    "time_mode",
    "requested_at",
    "passengers"
  ],
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_id": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "enum": [
        "RECORDED",
        "REJECTED",
        "TECHNICAL_ERROR"
      ],
      "description": "RECORDED = Anfrage erfasst und Zeitfenster geliefert; REJECTED = fachlich abgelehnt (Primärgrund Pflicht); TECHNICAL_ERROR = technischer Fehler, keine fachliche Ablehnung (zählt in `Technische Anfragefehler`, nie in Ablehnungskennzahlen)."
    },
    "primary_reason": {
      "enum": [
        "OUTSIDE_AREA",
        "OUTSIDE_HOURS",
        "NO_CAPACITY",
        "EQUIPMENT_MISSING",
        "RULE_FORBIDDEN",
        "NO_ROUTE",
        "LEAD_TIME",
        "HORIZON",
        "WINDOW_NOT_FEASIBLE",
        "NO_STOP_IN_RANGE",
        "NO_ACCESSIBLE_STOP",
        "NO_STAFF",
        "NO_TARIFF",
        "MAX_WAIT_EXCEEDED",
        "NO_VEHICLE",
        "SHIFT_ENDED",
        "MAX_DETOUR_EXCEEDED",
        "PARTNER_UNAVAILABLE",
        "TECHNICAL"
      ],
      "description": "Primärgrund der Ablehnung (Katalog `rejection_reason`, WP-M2-13; Kategorien nach Anhang K.1, Prioritätsregel in `RejectionCode`). `EQUIPMENT_MISSING` und `NO_ACCESSIBLE_STOP` zählen in `Ausstattungsablehnungen`."
    },
    "time_mode": {
      "enum": [
        "DEPARTURE",
        "ARRIVAL"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "passengers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "wheelchair": {
      "type": "integer",
      "minimum": 0
    },
    "coarse_origin": {
      "type": "string",
      "maxLength": 64
    },
    "coarse_destination": {
      "type": "string",
      "maxLength": 64
    },
    "secondary_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "OUTSIDE_AREA",
          "OUTSIDE_HOURS",
          "NO_CAPACITY",
          "EQUIPMENT_MISSING",
          "RULE_FORBIDDEN",
          "NO_ROUTE",
          "LEAD_TIME",
          "HORIZON",
          "WINDOW_NOT_FEASIBLE",
          "NO_STOP_IN_RANGE",
          "NO_ACCESSIBLE_STOP",
          "NO_STAFF",
          "NO_TARIFF",
          "MAX_WAIT_EXCEEDED",
          "NO_VEHICLE",
          "SHIFT_ENDED",
          "MAX_DETOUR_EXCEEDED",
          "PARTNER_UNAVAILABLE",
          "TECHNICAL"
        ]
      },
      "uniqueItems": true,
      "description": "Weitere Ursachen nach Priorität; der Versuch zählt nur beim Primärgrund."
    },
    "channel": {
      "type": "string",
      "enum": [
        "WEB",
        "APP",
        "API"
      ]
    },
    "is_test": {
      "type": "boolean",
      "description": "Optional: Testanfrage (WP-M4-47, Arbeitsannahme): wird aus den Kennzahlen ausgeschlossen; fehlt das Feld, ist es keine Testanfrage."
    }
  },
  "examples": [
    {
      "attempt_id": "5f1d4a0e-1b0a-4c3b-8e0f-2a3b4c5d6e7f",
      "service_id": "0f6f6d0a-3c7b-4d9e-8f10-1c2d3e4f5a6b",
      "outcome": "REJECTED",
      "primary_reason": "EQUIPMENT_MISSING",
      "time_mode": "DEPARTURE",
      "requested_at": "2026-11-01T10:00:00Z",
      "passengers": 2,
      "wheelchair": 1,
      "coarse_origin": "zone-nord",
      "coarse_destination": "zone-mitte"
    }
  ]
}
