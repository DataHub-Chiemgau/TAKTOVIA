{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktovia.invalid/schemas/acceptance/evidence.schema.json",
  "title": "Evidenzdatensatz je ausgeführtem Test (Kap. 08 §8.4)",
  "description": "Pflichtfelder: source_key[], Test-ID/Version, Software-Build, Migrationsstand, Konfigurations-/Tarif-/Vertragsrevision, Seed und Datenstand, Rollen und Mandanten, Soll/Ist, Ereignis-/Trace-IDs, Ergebnis, Mangelklasse, Verantwortlicher, Abnahmeentscheidung. Keine Fahrgast- oder Personaldaten (Prüfregel in taktovia_at/evidence.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "test", "source_key", "software_build", "migration_state", "revisions", "seed", "roles_and_tenants", "soll_ist", "event_trace_ids", "result", "defect_class", "responsible", "acceptance_decision", "executed_at", "clock", "environment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{16}$"},
    "test": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "kind", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^(AT-[0-9]{2}|E2E-[0-9]{3}|PH-AT-[0-9]{3}|TECH-[A-Z0-9-]+)$"},
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["AT", "E2E", "PH-AT", "TECH"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "source_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(LH-[0-9A-Za-z.]+-[A-Z]+-[0-9]+|ENABLER:WP-M[0-9a-z]+-[0-9]+)$"}},
    "software_build": {"type": "object", "additionalProperties": false, "required": ["build_id", "origin"], "properties": {"build_id": {"type": "string", "minLength": 1}, "origin": {"enum": ["TAKTOVIA_BUILD_ID", "git-head", "unversioniert"]}}},
    "migration_state": {"type": "object", "additionalProperties": false, "required": ["latest", "scripts"], "properties": {"latest": {"type": "string", "minLength": 1}, "scripts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["script", "checksum"], "properties": {"script": {"type": "string"}, "checksum": {"type": "integer"}}}}}},
    "revisions": {"type": "object", "additionalProperties": false, "required": ["config_revision", "tariff_revision", "contract_revision"], "properties": {"config_revision": {"type": "string", "minLength": 1}, "tariff_revision": {"type": "string", "minLength": 1}, "contract_revision": {"type": "string", "minLength": 1}}},
    "seed": {"type": "object", "additionalProperties": false, "required": ["name", "version", "data_state_sha256", "tenants"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "data_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "tenants": {"type": "object", "additionalProperties": {"type": "string", "format": "uuid"}}}},
    "roles_and_tenants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "tenant_id", "identity"], "properties": {"role": {"type": "string"}, "tenant_id": {"type": "string", "format": "uuid"}, "identity": {"type": "string", "description": "Testidentität aus WP-M0-09, kein realer Personenbezug"}}}},
    "soll_ist": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["step", "expected", "actual", "ok"], "properties": {"step": {"type": "string"}, "expected": {}, "actual": {}, "ok": {"type": "boolean"}}}},
    "event_trace_ids": {"type": "object", "additionalProperties": false, "required": ["event_ids", "trace_ids"], "properties": {"event_ids": {"type": "array", "items": {"type": "string"}}, "trace_ids": {"type": "array", "items": {"type": "string"}}}},
    "result": {"enum": ["PASSED", "FAILED", "NOT_EXECUTED"]},
    "defect_class": {"enum": ["A", "B", "C", null]},
    "responsible": {"type": "string", "minLength": 1, "description": "Rolle laut D-12, solange keine Personen benannt sind"},
    "acceptance_decision": {"enum": ["PENDING", "ACCEPTED", "REJECTED"], "description": "Die Automatik setzt immer PENDING; die Abnahme ist eine Entscheidung des Auftraggebers"},
    "executed_at": {"type": "string", "format": "date-time", "description": "Zeit der Testuhr (frozen), nicht Wanduhr"},
    "clock": {"type": "object", "additionalProperties": false, "required": ["start", "mode"], "properties": {"start": {"type": "string"}, "mode": {"enum": ["frozen", "real"]}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["name", "simulated_components"], "properties": {"name": {"type": "string"}, "simulated_components": {"type": "array", "items": {"type": "string"}, "description": "Simulator-/Sandbox-Anteile: Ergebnisse daraus sind kein Nachweis gegen reale PSP/Partner"}}}
  },
  "allOf": [
    {"if": {"properties": {"result": {"const": "FAILED"}}}, "then": {"properties": {"defect_class": {"enum": ["A", "B", "C"]}}}},
    {"if": {"properties": {"result": {"enum": ["PASSED", "NOT_EXECUTED"]}}}, "then": {"properties": {"defect_class": {"const": null}}}}
  ]
}
